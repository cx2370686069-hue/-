# 复制本文件为 .env 并填入真实值；切勿把真实凭据提交到仓库

# 服务器
PORT=3000
NODE_ENV=development

# 数据库
DB_HOST=localhost
DB_PORT=3306
DB_USER=replace_me
DB_PASSWORD=replace_me
DB_NAME=replace_me

# JWT（生产环境必须使用 >=64 字节强随机字符串，例如 `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`）
JWT_SECRET=replace_me_with_strong_random_secret
JWT_EXPIRES_IN=2h
JWT_ISSUER=gushi-waimai
JWT_AUDIENCE=gushi-waimai-clients

# 跨域：生产环境务必配置为前端域名白名单（逗号分隔），不要使用 *
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Socket 专用跨域白名单；未配置时回退到 CORS_ORIGIN
SOCKET_CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# 反向代理/Nginx 场景建议开启
# 可填 true / 1 / 具体层级值
TRUST_PROXY=1

# 腾讯地图（后端 WebService API）
TENCENT_MAP_KEY=replace_me
TENCENT_MAP_TIMEOUT_MS=8000

# 支付
# 生产环境请按实际接入通道设置为 wechat / alipay；mock 只保留为本地未接支付时的待确认流水通道。
PAYMENT_MODE=mock
# 用于支付回调的辅助校验 token；生产环境必填
PAYMENT_NOTIFY_TOKEN=replace_me_with_strong_random_token

# 管理端默认账号（仅初始化使用）
ADMIN_DEFAULT_PHONE=
ADMIN_DEFAULT_PASSWORD=
